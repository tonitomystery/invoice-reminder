<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_invoice_reminder" model="mail.template">
            <field name="name">Recordatorio de Facturas Próximas a Vencer</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Recordatorio: Facturas Próximas a Vencer</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) or '' }}</field>
            <field name="email_to">{{ object.partner_id.email or '' }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="description">Plantilla para enviar recordatorios de facturas por vencer.</field>
            <field name="body_html" type="html">
                <div style="font-family: 'Inter', Arial, sans-serif; color: #334155; max-width: 600px; margin: auto; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                    <!-- Cabecera -->
                    <div style="background-color: #0f172a; color: #ffffff; padding: 24px; text-align: center;">
                        <h2 style="margin: 0; font-size: 20px; font-weight: 600; letter-spacing: -0.025em;">Aviso de Próximo Vencimiento</h2>
                    </div>
                    
                    <div style="padding: 32px; background-color: #ffffff;">
                        <p style="margin-top: 0; font-size: 16px; line-height: 1.5;">
                            Estimado/a <strong t-out="object.partner_id.name"/>,
                        </p>
                        <p style="font-size: 15px; line-height: 1.6; color: #64748b;">
                            Le escribimos para recordarle cordialmente que las siguientes facturas están próximas a vencer:
                        </p>
                        
                        <!-- Tabla de Facturas -->
                        <div style="margin-top: 24px; border: 1px solid #f1f5f9; border-radius: 6px; overflow: hidden;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                                <thead>
                                    <tr style="background-color: #f8fafc;">
                                        <th style="padding: 12px; text-align: left; border-bottom: 1px solid #f1f5f9; color: #475569; font-weight: 600;">Documento / NCF</th>
                                        <th style="padding: 12px; text-align: center; border-bottom: 1px solid #f1f5f9; color: #475569; font-weight: 600;">Vencimiento</th>
                                        <th style="padding: 12px; text-align: right; border-bottom: 1px solid #f1f5f9; color: #475569; font-weight: 600;">Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="ctx.get('invoice_ids', [])" t-as="inv_id">
                                        <t t-set="inv" t-value="object.env['account.move'].browse(inv_id)"/>
                                        <tr>
                                            <td style="padding: 12px; border-bottom: 1px solid #f1f5f9;">
                                                <div style="font-weight: 500; color: #1e293b;" t-out="inv.name"/>
                                                <div style="font-size: 12px; color: #94a3b8;" t-out="inv.l10n_do_fiscal_number or ''"/>
                                            </td>
                                            <td style="padding: 12px; text-align: center; border-bottom: 1px solid #f1f5f9; color: #475569;" t-out="inv.invoice_date_due"/>
                                            <td style="padding: 12px; text-align: right; border-bottom: 1px solid #f1f5f9; font-weight: 500; color: #0f172a;" t-out="format_amount(inv.amount_residual, inv.currency_id)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Total -->
                        <div style="margin-top: 20px; text-align: right; font-size: 16px;">
                            <span style="color: #64748b;">Total a Pagar: </span>
                            <strong style="color: #2563eb; font-size: 18px;" t-out="format_amount(ctx.get('total_due', 0), object.currency_id)"/>
                        </div>
                        
                        <p style="margin-top: 32px; font-size: 14px; line-height: 1.6; color: #64748b;">
                            Agradecemos de antemano su gestión de pago para evitar interrupciones en su servicio.
                        </p>
                    </div>
                    
                    <!-- Pie de página -->
                    <div style="background-color: #f8fafc; padding: 24px; border-top: 1px solid #f1f5f9; text-align: center; font-size: 13px; color: #94a3b8;">
                        Atentamente,<br/>
                        <strong style="color: #475569;">Departamento de Administración</strong><br/>
                        <t t-out="object.company_id.name"/>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
