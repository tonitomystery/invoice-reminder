<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View partner.reminder View Tree -->
    <record id="view_partner_reminder_tree" model="ir.ui.view">
        <field name="name">view.partner.reminder.tree</field>
        <field name="model">partner.reminder</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View partner.reminder form -->
    <record id="view_partner_reminder_form" model="ir.ui.view">
        <field name="name">view.partner.reminder.form</field>
        <field name="model">partner.reminder</field>
        <field name="arch" type="xml">
            <form string="Partner Reminder">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View partner.reminder search -->
    <record id="view_partner_reminder_search" model="ir.ui.view">
        <field name="name">view.partner.reminder.search</field>
        <field name="model">partner.reminder</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action partner.reminder -->
    <record id="action_partner_reminder" model="ir.actions.act_window">
        <field name="name">Partner Reminder</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">partner.reminder</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Partner Reminder.
            </p>
        </field>
    </record>

</odoo>
