<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View invoice.reminder.config View Tree -->
    <record id="view_invoice_reminder_config_tree" model="ir.ui.view">
        <field name="name">invoice.reminder.config.tree</field>
        <field name="model">invoice.reminder.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="partner_id" />
                <field name="days" />
                <field name="active" />
            </tree>
        </field>
    </record>
    <!-- View invoice.reminder.config form -->
    <record id="view_invoice_reminder_config_form" model="ir.ui.view">
        <field name="name">invoice.reminder.config.form</field>
        <field name="model">invoice.reminder.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Días de Aviso">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="partner_id" />
                        <field name="days" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- View invoice.reminder.config search -->
    <record id="view_invoice_reminder_config_search" model="ir.ui.view">
        <field name="name">view.invoice.reminder.config.search</field>
        <field name="model">invoice.reminder.config</field>
        <field name="arch" type="xml">
            <search>
                <group string="Group By" expand="1">
                    <filter name="name" string="Name" domain="[]" context="{'group_by':'name'}" />
                </group>
            </search>
        </field>
    </record>
    <!-- Action invoice.reminder.config -->
    <record id="action_invoice_reminder_config" model="ir.actions.act_window">
        <field name="name">Configuraciones de Recordatorio de Factura</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">invoice.reminder.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Crea una nueva configuración de días de aviso para un partner.</p>
        </field>
    </record>

    <menuitem id="menu_invoice_reminder_config_root" name="Recordatorios de Factura" sequence="100" />

    <menuitem id="menu_invoice_reminder_config" name="Configuraciones de Días de Aviso" parent="menu_invoice_reminder_config_root" action="action_invoice_reminder_config" sequence="10" />
</odoo>